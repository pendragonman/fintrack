generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AccountType {
  CASH
  BANK
  CARD
  WALLET
  SAVINGS
  INVESTMENT
}

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  passwordHash           String?
  googleId               String?   @unique
  name                   String
  currency               String    @default("NGN")
  emailVerified          Boolean   @default(true)
  verificationCode       String?
  verificationCodeExpiry DateTime?
  resetTokenHash         String?
  resetTokenExpiry       DateTime?
  failedLoginAttempts    Int       @default(0)
  lockedUntil            DateTime?
  createdAt              DateTime  @default(now())

  transactions Transaction[]
  budgets      Budget[]
  goals        SavingsGoal[]
  accounts     Account[]
  rules        CategoryRule[]
}

model Account {
  id             String      @id @default(uuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           AccountType @default(BANK)
  openingBalance Decimal     @default(0) @db.Decimal(14, 2)
  archived       Boolean     @default(false)
  createdAt      DateTime    @default(now())

  transactions Transaction[]

  @@unique([userId, name])
}

model Transaction {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            TransactionType
  amount          Decimal          @db.Decimal(14, 2)
  category        String
  description     String?
  date            DateTime
  accountId       String?
  account         Account?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  // Both legs of a transfer share this id. Transfers are excluded from income,
  // expense, budget and report totals because moving money between your own
  // accounts is not spending.
  transferGroupId String?
  createdAt       DateTime         @default(now())

  @@index([userId, date])
  @@index([userId, category])
  @@index([userId, accountId])
  @@index([userId, transferGroupId])
}

model Budget {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String
  limitAmount Decimal  @db.Decimal(14, 2)
  month       Int
  year        Int
  createdAt   DateTime @default(now())

  @@unique([userId, category, month, year])
}

model SavingsGoal {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  targetAmount   Decimal   @db.Decimal(14, 2)
  currentAmount  Decimal   @default(0) @db.Decimal(14, 2)
  targetDate     DateTime?
  createdAt      DateTime  @default(now())
}

// A keyword rule that assigns a category by looking inside the description.
// Used when importing a bank/wallet CSV and when re-categorising history.
model CategoryRule {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match     String
  category  String
  type      String?
  priority  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}
