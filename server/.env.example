# Pooled connection (Neon host containing "-pooler") — used by the app at runtime
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Direct (unpooled) connection — used by Prisma CLI commands (migrate, db push)
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"
JWT_SECRET="replace-with-a-long-random-string"
PORT=4000
# Comma-separated list of allowed browser origins, e.g.
# "https://your-client.vercel.app,http://localhost:5173"
CLIENT_ORIGIN="http://localhost:5173"
GOOGLE_CLIENT_ID="replace-with-your-google-oauth-client-id"
GMAIL_USER="your-gmail-address@gmail.com"
GMAIL_APP_PASSWORD="your-16-character-app-password"
